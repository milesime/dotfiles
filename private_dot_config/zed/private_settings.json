{
  "auto_install_extensions": {
    "catppuccin": true,
    "git-firefly": true,
    "ocaml": true,
    "oxc": true,
    "tombi": true,
    "toml": true,
    "typst": true,
    "zig": true
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "colorize_brackets": true,
  "completion_menu_item_kind": "symbol",
  "disable_ai": true,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "format_on_save": "on",
  "lsp": {
    "tinymist": {
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true
          }
        }
      },
      "settings": {
        "formatterPrintWidth": 80
      }
    }
  },
  "project_panel": {
    "hide_root": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "tabs": {
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte"
  },
  "title_bar": {
    "show_sign_in": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "ui_font_family": ".SystemUIFont"
}
